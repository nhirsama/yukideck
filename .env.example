# === HTTP & Dual-Mode Deployment ===
HTTP_ADDR=:8080
# Public HTTPS URL of YukiDeck backend (used to register Telegram Webhooks and render PushURLs)
PUBLIC_BASE_URL=http://localhost:8080
# Set to false when deploying frontend separately on Nginx/CDN/Pages
UI_ENABLED=true
# Redirect target after OIDC callback ("/" in embedded mode, or "https://deck.example.com" in separated mode)
FRONTEND_BASE_URL=/
# Comma-separated allowed origins for separated deployment (leave empty in same-origin embedded mode)
CORS_ALLOWED_ORIGINS=

# === Cookie Settings ===
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# === External PostgreSQL ===
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/yukideck?sslmode=disable

# === Security & Encryption ===
# 32-byte key encoded in hex (64 chars) or base64 (44 chars), e.g. `openssl rand -hex 32`
APP_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# === Standard OIDC SSO ===
OIDC_ISSUER=https://sso.example.com
OIDC_CLIENT_ID=yukideck
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
OIDC_SCOPES=openid,profile,email

# === Module & Runtime Controls ===
# Comma-separated module IDs to disable (e.g. "cron")
DISABLED_MODULES=
LOG_LEVEL=info
LOG_FORMAT=text

# === Server Protection Guardrails (Only for paths touching server resources) ===
REQUEST_MAX_BODY_BYTES=1048576
EXTERNAL_HTTP_TIMEOUT=10s
# Only applies to proxy uploads & bot media transfers (direct S3 uploads have NO limit)
STORAGE_PROXY_MAX_MB=20
